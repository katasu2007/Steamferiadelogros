    descomenta esta línea e instala el paquete:
    dotnet add package Microsoft.Data.Sqlite
  -->
  <!-- <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup> -->

</Project>
